{
  // =================================================
  // Antigravity IDE — editor-specific overrides layered on top of
  // configs/editors/common.json by scripts/sync-editor-settings.sh
  // =================================================
  "workbench.colorTheme": "Kimbie Dark",

  // Orange accent — title bar/activity bar tint so this window is
  // recognizable at a glance even before a theme's syntax colors show
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#E65100",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#BF360CAA",
    "activityBar.background": "#BF360C",
    "tab.activeBorderTop": "#00FF00",
    "tab.unfocusedActiveBorderTop": "#00FF0088",
    "textCodeBlock.background": "#00000055",
    "editor.wordHighlightStrongBorder": "#FF6347",
    "editor.wordHighlightBorder": "#FFD700",
    "editor.selectionHighlightBorder": "#A9A9A9"
  },

  // Gemini Code Assist — Antigravity's own GCP project
  "geminicodeassist.project": "ancient-rune-gthmw",

  // Point Antigravity at the official VS Code marketplace
  "antigravity.marketplaceGalleryItemURL": "https://marketplace.visualstudio.com/items",
  "antigravity.marketplaceExtensionGalleryServiceURL": "https://marketplace.visualstudio.com/_apis/public/gallery",

  // Fixed 2026-08-01: was a leftover Windows path (C:\Users\deepa\anaconda3\...)
  // from cross-machine copy — corrected to the actual Mac anaconda3 install
  "python.pythonPath": "/Users/shrutirastogi/anaconda3/bin/python",
  "python.terminal.activateEnvironment": true,

  "window.newWindowProfile": "DS-Common",
  "security.workspace.trust.untrustedFiles": "open"
}
