[safe]
    directory = *
[push]
    autoSetupRemote = true
[include]
    path = ~/.gitconfig.local
[core]
    symlinks = true
	excludesfile = ~/.gitignore_global
[pull]
	rebase = true
[rebase]
	autoStash = true

[diff]
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE