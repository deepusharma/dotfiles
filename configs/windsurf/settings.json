{
  
  // =================================================
  // Shared baseline for every VS Code–family editor
  // (VS Code, Antigravity IDE, Cursor, Kiro, Windsurf/Devin)
  // =================================================
  // This file is NOT read directly by any editor. Each editor's real
  // settings.json (configs/<editor>/settings.json) is generated by
  // `scripts/sync-editor-settings.sh`, which splices this file's keys
  // with that editor's own configs/<editor>/overrides.json.
  //
  // Rule of thumb for what belongs here vs. in an overrides.json:
  //   - workbench.colorTheme is ALWAYS per-editor (visual distinction
  //     between editors is intentional) — never put it here.
  //   - Anything naming a specific product (antigravity.*, kiroAgent.*,
  //     geminicodeassist.project) belongs in that editor's overrides.json.
  //   - Java/Maven/JDK blocks are deliberately excluded — they're
  //     machine-generated per-editor by the Pleiades JDK extension
  //     wherever it's installed; don't manage them centrally.
  //
  // After editing this file, run:
  //   ./scripts/dotfiles.sh sync-editors
  // to regenerate every editor's settings.json.

  // =================================================
  // Editor
  // =================================================
  // Format with Prettier on every save
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // JetBrains Mono (installed via Brewfile) with ligatures (=> !== render as single glyphs)
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Menlo, monospace",
  "editor.fontLigatures": true,
  // Vertical guide connecting the bracket pair around the cursor
  "editor.guides.bracketPairs": "active",
  // Rename opening/closing HTML-XML tags together
  "editor.linkedEditing": true,
  // Hide the minimap to reclaim horizontal space
  "editor.minimap.enabled": false,
  // Ctrl/Cmd + scroll wheel zooms the editor font
  "editor.mouseWheelZoom": true,
  // Optimize the editor for screen-reader use
  "editor.accessibilitySupport": "on",
  // Subtle line-length guides at 80 / 100 / 120 columns
  "editor.rulers": [
    { "column": 80, "color": "#00FF0010" },
    { "column": 100, "color": "#BDB76B15" },
    { "column": 120, "color": "#FA807219" }
  ],
  // Flag invisible/confusable Unicode characters inside comments too
  "editor.unicodeHighlight.includeComments": true,
  // Collapse multi-line inline suggestions until expanded
  "editor.inlineSuggest.edits.showCollapsed": true,

  // =================================================
  // Files
  // =================================================
  // Unix line endings everywhere (see [bat] override below)
  "files.eol": "\n",
  // Strip trailing spaces on save (disabled for Markdown below)
  "files.trimTrailingWhitespace": true,
  // Persist unsaved buffers (including untitled scratch tabs) across quit/restart —
  // this is VS Code's default already, made explicit here
  "files.hotExit": "onExitAndWindowClose",

  // =================================================
  // Workbench / UI
  // (workbench.colorTheme intentionally NOT here — see header note)
  // =================================================
  // Green top border on the active tab; subtle word-highlight borders
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "tab.activeBorderTop": "#00FF00",
      "tab.unfocusedActiveBorderTop": "#00FF0088",
      "textCodeBlock.background": "#00000055"
    },
    "editor.wordHighlightStrongBorder": "#FF6347",
    "editor.wordHighlightBorder": "#FFD700",
    "editor.selectionHighlightBorder": "#A9A9A9"
  },
  // Focus the existing tab instead of opening a duplicate
  "workbench.editor.revealIfOpen": true,
  // Auto-run workspace tasks marked "runOn": "folderOpen"
  "task.allowAutomaticTasks": "on",

  // =================================================
  // Explorer
  // =================================================
  // Skip confirmation dialogs for delete and drag-and-drop
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // =================================================
  // Git / GitLens
  // =================================================
  // Fetch remotes periodically in the background
  "git.autofetch": true,
  // Don't ask before git sync (pull + push)
  "git.confirmSync": false,
  // GitLens AI (commit messages etc.) via GitKraken-hosted Gemini
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",

  // =================================================
  // AI Assistants — Claude Code, Copilot
  // (geminicodeassist.project intentionally NOT here — per-editor project ID)
  // =================================================
  // Open Claude Code in the bottom panel instead of the sidebar
  "claudeCode.preferredLocation": "panel",
  // Copilot everywhere except plaintext and the commit-message box
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  // Stack chat sessions vertically in the Chat view
  "chat.viewSessions.orientation": "stacked",
  // Let chat agents run `wsl` in the terminal without approval
  "chat.tools.terminal.autoApprove": {
    "wsl": true
  },
  // Reuse Claude Code hooks in chat, and where to find them
  "chat.useClaudeHooks": true,
  "chat.hookFilesLocations": {
    ".github/hooks": true,
    ".claude/settings.local.json": true,
    ".claude/settings.json": true,
    "~/.copilot/hooks": true,
    "~/.claude/settings.json": true,
    "~/.agents/hooks": true
  },
  // Agent Compose — token stays blank here; never commit secrets
  "agentCompose.apiToken": "",

  // =================================================
  // Markdown
  // =================================================
  // Markdown Preview Enhanced
  "markdown-preview-enhanced.enablePreviewZenMode": false,
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  // Chrome binary used by Markdown for Humans for PDF/print export
  "markdownForHumans.chromePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",

  // =================================================
  // Python
  // =================================================
  "python.languageServer": "Default",
  // Pylance: report basic type errors
  "python.analysis.typeCheckingMode": "basic",

  // =================================================
  // Terminal — General
  // (Java-pinned terminal profiles intentionally NOT here — Pleiades-managed
  // per editor; see AGENTS.md "Java is NOT part of the stack")
  // =================================================
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.mouseWheelZoom": true,
  // Always show terminal tabs, even with a single terminal
  "terminal.integrated.tabs.hideCondition": "never",
  // Don't restore terminal sessions across window reloads
  "terminal.integrated.enablePersistentSessions": false,

  // =================================================
  // Remote / WSL
  // =================================================
  // Detect forwardable ports from both process list and terminal output
  "remote.autoForwardPortsSource": "hybrid",
  // Trust the WSL UNC host for \\wsl.localhost file access
  "security.allowedUNCHosts": ["wsl.localhost"],

  // =================================================
  // System / Network
  // =================================================
  // Use the OS certificate store for Node HTTP requests (corporate TLS/proxy)
  "http.systemCertificatesNode": true,
  // Allow up to 20s to resolve the login-shell environment at startup
  "application.shellEnvironmentResolutionTimeout": 20,

  // =================================================
  // TODO Tree
  // =================================================
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "HACK",
    "BUG",
    "NOTE",
    "OPTIMIZE",
    "REVIEW"
  ],
  "todo-tree.tree.showCountsInTree": true,
  "todo-tree.tree.groupedByTag": true,
  // Per-tag colors and icons in the tree and editor
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "foreground": "#000",
      "background": "#FFD700",
      "iconColour": "#FFD700"
    },
    "FIXME": {
      "icon": "alert",
      "foreground": "#fff",
      "background": "#e45454",
      "iconColour": "#e45454"
    },
    "NOTE": {
      "icon": "info",
      "foreground": "#fff",
      "background": "#4CAF50",
      "iconColour": "#4CAF50"
    },
    "REVIEW": {
      "icon": "eye",
      "foreground": "#fff",
      "background": "#7B68EE",
      "iconColour": "#7B68EE"
    },
    "OPTIMIZE": {
      "icon": "zap",
      "foreground": "#fff",
      "background": "#FF8C00",
      "iconColour": "#FF8C00"
    }
  },

  // =================================================
  // Other Extensions
  // =================================================
  // Emmet: default lang attribute for expanded HTML
  "emmet.variables": { "lang": "en" },
  // Spelling issues as unobtrusive hints, not warnings
  "cSpell.diagnosticLevel": "Hint",
  // Highlight trailing whitespace in red (complements trim-on-save above)
  "trailing-spaces.backgroundColor": "rgba(255,0,0,0.1)",
  "trailing-spaces.includeEmptyLines": false,
  // Live Server: quiet startup, full-page reloads, 10s debounce
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.AdvanceCustomBrowserCmdLine": "",
  "liveServer.settings.fullReload": true,
  "liveServer.settings.wait": 10000,
  // Draw.io: keep pasted images at original size
  "hediet.vscode-drawio.resizeImages": null,
  // Azure Resource Graph tenant (blank = default tenant)
  "@azure.argTenant": "",

  // =================================================
  // Per-language Overrides
  // =================================================
  // Windows batch files require CRLF line endings
  "[bat]": {
    "files.eol": "\r\n"
  },
  // Built-in JSON formatter handles JSONC comments better than Prettier
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    // Show whitespace changes in diffs — trailing spaces matter in Markdown
    "diffEditor.ignoreTrimWhitespace": false,
    // Keep trailing spaces: two spaces at line end = hard line break
    "files.trimTrailingWhitespace": false
  },

  // =================================================
  // Windsurf/Devin overrides (from configs/windsurf/overrides.json)
  // =================================================
  // =================================================
  // Windsurf/Devin — editor-specific overrides layered on top of
  // configs/editors/common.json by scripts/sync-editor-settings.sh
  //
  // Treated as ONE identity: Windsurf was acquired by Cognition (Devin's
  // maker) and the two are now the same product — this file is symlinked
  // into both apps' settings.json paths.
  // =================================================
  "workbench.colorTheme": "Monokai"
}
