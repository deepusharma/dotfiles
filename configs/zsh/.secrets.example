# ~/.secrets — private API keys and tokens, sourced by .zshrc on every shell.
# install.sh copies this template to ~/.secrets (chmod 600) if it doesn't exist.
# NEVER commit the real ~/.secrets — only this .example lives in the repo.

# Anthropic (Claude Code / API)
export ANTHROPIC_API_KEY=""

# OpenAI-compatible endpoint (real key, or a router/proxy alias)
export OPENAI_API_KEY=""
