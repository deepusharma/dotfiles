{
  // =================================================
  // Editor
  // =================================================
  // Format with Prettier on every save
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // JetBrains Mono (installed via Brewfile) with ligatures (=> !== render as single glyphs)
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Menlo, monospace",
  "editor.fontLigatures": true,
  // Vertical guide connecting the bracket pair around the cursor
  "editor.guides.bracketPairs": "active",
  // Rename opening/closing HTML-XML tags together
  "editor.linkedEditing": true,
  // Hide the minimap to reclaim horizontal space
  "editor.minimap.enabled": false,
  // Ctrl/Cmd + scroll wheel zooms the editor font
  "editor.mouseWheelZoom": true,
  // Optimize the editor for screen-reader use
  "editor.accessibilitySupport": "on",
  // Subtle line-length guides at 80 / 100 / 120 columns
  "editor.rulers": [
    { "column": 80, "color": "#00FF0010" },
    { "column": 100, "color": "#BDB76B15" },
    { "column": 120, "color": "#FA807219" }
  ],
  // Flag invisible/confusable Unicode characters inside comments too
  "editor.unicodeHighlight.includeComments": true,
  // Collapse multi-line inline suggestions until expanded
  "editor.inlineSuggest.edits.showCollapsed": true,


  // =================================================
  // Files
  // =================================================
  // Unix line endings everywhere (see [bat] override below)
  "files.eol": "\n",
  // Strip trailing spaces on save (disabled for Markdown below)
  "files.trimTrailingWhitespace": true,


  // =================================================
  // Workbench / UI
  // =================================================
  "workbench.colorTheme": "Solarized Dark",
  // Green top border on the active tab; subtle word-highlight borders
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "tab.activeBorderTop": "#00FF00",
      "tab.unfocusedActiveBorderTop": "#00FF0088",
      "textCodeBlock.background": "#00000055"
    },
    "editor.wordHighlightStrongBorder": "#FF6347",
    "editor.wordHighlightBorder": "#FFD700",
    "editor.selectionHighlightBorder": "#A9A9A9"
  },
  // Focus the existing tab instead of opening a duplicate
  "workbench.editor.revealIfOpen": true,
  // Auto-run workspace tasks marked "runOn": "folderOpen"
  "task.allowAutomaticTasks": "on",


  // =================================================
  // Explorer
  // =================================================
  // Skip confirmation dialogs for delete and drag-and-drop
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,


  // =================================================
  // Git / GitLens
  // =================================================
  // Fetch remotes periodically in the background
  "git.autofetch": true,
  // Don't ask before git sync (pull + push)
  "git.confirmSync": false,
  // GitLens AI (commit messages etc.) via GitKraken-hosted Gemini
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",


  // =================================================
  // AI Assistants — Claude Code, Copilot, Gemini
  // =================================================
  // Open Claude Code in the bottom panel instead of the sidebar
  "claudeCode.preferredLocation": "panel",
  // Copilot everywhere except plaintext and the commit-message box
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  // Stack chat sessions vertically in the Chat view
  "chat.viewSessions.orientation": "stacked",
  // Let chat agents run `wsl` in the terminal without approval
  "chat.tools.terminal.autoApprove": {
    "wsl": true
  },
  // Reuse Claude Code hooks in VS Code chat, and where to find them
  "chat.useClaudeHooks": true,
  "chat.hookFilesLocations": {
    ".github/hooks": true,
    ".claude/settings.local.json": true,
    ".claude/settings.json": true,
    "~/.copilot/hooks": true,
    "~/.claude/settings.json": true,
    "~/.agents/hooks": true
  },
  // Gemini Code Assist
  "geminicodeassist.project": "gen-lang-client-0572315771",
  "geminicodeassist.displayInlineContextHint": false,
  // Agent Compose — token stays blank here; never commit secrets
  "agentCompose.apiToken": "",


  // =================================================
  // Markdown
  // =================================================
  // Markdown Preview Enhanced
  "markdown-preview-enhanced.enablePreviewZenMode": false,
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  // Chrome binary used by Markdown for Humans for PDF/print export
  "markdownForHumans.chromePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",


  // =================================================
  // Python
  // =================================================
  "python.languageServer": "Default",
  // Pylance: report basic type errors
  "python.analysis.typeCheckingMode": "basic",


  // =================================================
  // Java / Maven
  // JDKs, Gradle and Maven are auto-managed by the
  // Pleiades JDK Extension Pack (paths below)
  // =================================================
  // Null-pointer analysis based on annotations
  "java.compile.nullAnalysis.mode": "automatic",
  // Skip JDK auto-detection at startup — runtimes are pinned below
  "java.configuration.detectJdksAtStart": false,
  // Rebuild config automatically when build files change
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/java/17"
    },
    {
      "name": "JavaSE-21",
      "path": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/java/21"
    },
    {
      "name": "JavaSE-25",
      "path": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/java/25"
    },
    {
      "name": "JavaSE-26",
      "path": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/java/latest",
      "default": true
    }
  ],
  // Apply code changes while debugging without restart
  "java.debug.settings.hotCodeReplace": "auto",
  // Show packages as a tree instead of flat names
  "java.dependency.packagePresentation": "hierarchical",
  "java.import.gradle.home": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/gradle/latest",
  "java.import.gradle.java.home": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/java/25",
  "java.maxConcurrentBuilds": 8,
  // Use static star-imports after a single member
  "java.sources.organizeImports.staticStarThreshold": 1,
  // Force UTF-8 output in test runs
  "java.test.config": {
    "vmArgs": [
      "-Dstdout.encoding=UTF-8",
      "-Dstderr.encoding=UTF-8"
    ]
  },
  "jdk.telemetry.enabled": false,
  "redhat.telemetry.enabled": false,
  "maven.executable.path": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/maven/latest/bin/mvn",
  "maven.terminal.customEnv": [
    {
      "environmentVariable": "JAVA_HOME",
      "value": "/Users/shrutirastogi/Library/Application Support/Code/User/globalStorage/pleiades.java-extension-pack-jdk/java/25"
    },
    {
