  // =================================================
  // Remote / WSL
  // =================================================
  // Detect forwardable ports from both process list and terminal output
  "remote.autoForwardPortsSource": "hybrid",
  // Trust the WSL UNC host for \\wsl.localhost file access
  "security.allowedUNCHosts": ["wsl.localhost"],


  // =================================================
  // Antigravity
  // =================================================
  // Point Antigravity at the official VS Code marketplace
  "antigravity.marketplaceGalleryItemURL": "https://marketplace.visualstudio.com/items",
  "antigravity.marketplaceExtensionGalleryServiceURL": "https://marketplace.visualstudio.com/_apis/public/gallery",


  // =================================================
  // System / Network
  // =================================================
  // Use the OS certificate store for Node HTTP requests (corporate TLS/proxy)
  "http.systemCertificatesNode": true,
  // Allow up to 20s to resolve the login-shell environment at startup
  "application.shellEnvironmentResolutionTimeout": 20,


  // =================================================
  // TODO Tree
  // =================================================
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "HACK",
    "BUG",
    "NOTE",
    "OPTIMIZE",
    "REVIEW"
  ],
  "todo-tree.tree.showCountsInTree": true,
  "todo-tree.tree.groupedByTag": true,
  // Per-tag colors and icons in the tree and editor
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "foreground": "#000",
      "background": "#FFD700",
      "iconColour": "#FFD700"
    },
    "FIXME": {
      "icon": "alert",
      "foreground": "#fff",
      "background": "#e45454",
      "iconColour": "#e45454"
    },
    "NOTE": {
      "icon": "info",
      "foreground": "#fff",
      "background": "#4CAF50",
      "iconColour": "#4CAF50"
    },
    "REVIEW": {
      "icon": "eye",
      "foreground": "#fff",
      "background": "#7B68EE",
      "iconColour": "#7B68EE"
    },
    "OPTIMIZE": {
      "icon": "zap",
      "foreground": "#fff",
      "background": "#FF8C00",
      "iconColour": "#FF8C00"
    }
  },


  // =================================================
  // Other Extensions
  // =================================================
  // Emmet: default lang attribute for expanded HTML
  "emmet.variables": { "lang": "en" },
  // Spelling issues as unobtrusive hints, not warnings
  "cSpell.diagnosticLevel": "Hint",
  // Highlight trailing whitespace in red (complements trim-on-save above)
  "trailing-spaces.backgroundColor": "rgba(255,0,0,0.1)",
  "trailing-spaces.includeEmptyLines": false,
  // Live Server: quiet startup, full-page reloads, 10s debounce
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.AdvanceCustomBrowserCmdLine": "",
  "liveServer.settings.fullReload": true,
  "liveServer.settings.wait": 10000,
  // Draw.io: keep pasted images at original size
  "hediet.vscode-drawio.resizeImages": null,
  // Azure Resource Graph tenant (blank = default tenant)
  "@azure.argTenant": "",


  // =================================================
  // Per-language Overrides
  // =================================================
  // Windows batch files require CRLF line endings
  "[bat]": {
    "files.eol": "\r\n"
  },
  // Built-in JSON formatter handles JSONC comments better than Prettier
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    // Show whitespace changes in diffs — trailing spaces matter in Markdown
    "diffEditor.ignoreTrimWhitespace": false,
    // Keep trailing spaces: two spaces at line end = hard line break
    "files.trimTrailingWhitespace": false
  }
}
